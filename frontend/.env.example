# Ark multimodal model
ARK_API_KEY=replace-with-your-ark-api-key
ARK_MODEL=doubao-seed-2-0-lite-260428
ARK_RESPONSES_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/responses

# Volcengine ASR
VOLCENGINE_ASR_API_KEY=replace-with-your-volcengine-speech-api-key
VOLCENGINE_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
VOLCENGINE_ASR_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
VOLCENGINE_ASR_UID=xiaolu-web

# Volcengine TTS
VOLCENGINE_TTS_API_KEY=replace-with-your-volcengine-speech-api-key
VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
VOLCENGINE_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional
VOLCENGINE_TTS_MODEL=seed-tts-2.0-standard
VOLCENGINE_TTS_SPEAKER=zh_female_shuangkuaisisi_moon_bigtts
VOLCENGINE_TTS_UID=xiaolu-web
